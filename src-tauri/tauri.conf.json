{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Youtube-Simple-Downloader",
  "version": "1.0.0",
  "identifier": "dev.jvps.youtubesimpledownloader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Youtube Simple Downloader",
        "width": 440,
        "height": 480,
        "minWidth": 400,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
